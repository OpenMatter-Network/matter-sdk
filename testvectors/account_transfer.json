  "sudo_batch": {
    "_comment": "How steps become one operator call: Utility.batch_all of Sudo.sudo_as(actor, call). sudo_as never fails the outer call; each item reports its own result.",
    "steps": [
      ["old", "5Old", "Budgets.revoke_agent_key", ["5Key"]],
      ["new", "5New", "Budgets.authorize_agent_key", ["5Key", 48]]
    ],
    "tree": {
      "pallet": "Utility",
      "call": "batch_all",
      "args": [
        [
          {
            "pallet": "Sudo",
            "call": "sudo_as",
            "args": [
              "5Old",
              {
                "pallet": "Budgets",
                "call": "revoke_agent_key",
                "args": [
                  "5Key"
                ]
              }
            ]
          },
          {
            "pallet": "Sudo",
            "call": "sudo_as",
            "args": [
              "5New",
              {
