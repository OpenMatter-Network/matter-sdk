{
  "name": "@openmatter-network/matter-client",
  "version": "1.0.0",
  "description": "TypeScript client for OpenMatter: one apiKey, every pallet. Wraps @openmatter-network/matter-vault with a metadata-driven chain client (tx / query / runtimeApi) plus the MatterVault threshold-secret path.",
  "license": "Apache-2.0",
  "author": "Open Matter <admin@openmatter.network>",
  "homepage": "https://openmatter.network",
  "repository": "https://github.com/openmatter-network/matter-sdk",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@polkadot/api": "^16.5.4"
  },
  "peerDependencies": {
    "@openmatter-network/matter-vault": "1.0.0"
  },
  "devDependencies": {
    "@openmatter-network/matter-vault": "file:../typescript",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
