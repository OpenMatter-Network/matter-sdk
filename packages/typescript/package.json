{
  "name": "@openmatter-network/matter-sdk",
  "version": "2.0.0",
  "description": "TypeScript SDK for MatterChain and the OpenMatter platform: one apiKey, every pallet. A metadata-driven chain client (tx / query / runtimeApi) plus threshold Secrets, re-exporting @openmatter-network/matter-sdk-core.",
  "license": "Apache-2.0",
  "author": "Open Matter <admin@openmatter.network>",
  "homepage": "https://openmatter.network",
  "repository": "https://github.com/openmatter-network/matter-sdk",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openmatter-network/matter-sdk-core": "^2.0.0",
    "@polkadot/api": "^16.5.4"
  },
  "devDependencies": {
    "@openmatter-network/matter-sdk-core": "file:../typescript-core",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
